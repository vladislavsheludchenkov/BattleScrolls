## Title: Battle Scrolls
## Author: Semigroup1329
## Description: Combat metrics tracking on consoles with native gamepad UI.
## APIVersion: 101048
## AddOnVersion: {{addon_version}}
## Version: {{version}}
## IsLibrary: False
## DependsOn: LibGroupBroadcast>=95 LibAsync>=30100
## OptionalDependsOn: LibHarvensAddonSettings
## SavedVariables: BattleScrollsSavedVariables

; Localization - default (English) must load first
lang/default.lua
; Client language override ($(language) = de, fr, es, ru, jp, zh, or en)
lang/$(language).lua

; Access control
accesscheck.lua

; Havok structures (must load before modules that use them)
havok/structures.lua

; Constants
constants.lua

; Core infrastructure
core/utils.lua
core/effect.lua
core/gc.lua
core/log.lua

; Combat domain
combat/arithmancer.lua
combat/accumulators.lua
combat/effects.lua
combat/effects_events.lua
combat/effects_reconcile.lua
combat/deathrecap.lua
combat/state.lua
combat/scribe.lua
combat/ticker.lua
combat/setup.lua
combat/setup_analysis.lua

; Storage domain
storage/bitcodec.lua
storage/binary.lua
storage/storage.lua

; Network domain
network/lgb.lua
network/dpsshare.lua
network/dpssender.lua
network/encountershare.lua
network/setupshare.lua

; Entry point
main.lua

; UI - DPS Meter
ui/meter/types.lua
ui/meter/utils.lua
ui/meter/designs/core.lua
ui/meter/row_factories.lua
ui/meter/designs/personal/default.lua
ui/meter/designs/personal/minimal.lua
ui/meter/designs/personal/bar.lua
ui/meter/designs/group/text.lua
ui/meter/designs/group/hodor.lua
ui/meter/designs/group/bars.lua
ui/meter/meter.lua
ui/meter/meter.xml

; UI - Journal (types and utils load first, then renderers, then controllers)
ui/journal/types.lua
ui/journal/utils.lua
ui/journal/control_pool.lua
ui/journal/component_factory.lua
ui/journal/entry_builder.lua
ui/journal/tooltips.lua
ui/journal/renderers/damage.lua
ui/journal/renderers/healing.lua
ui/journal/renderers/effects.lua
ui/journal/renderers/group.lua
ui/journal/renderers/setup.lua
ui/journal/renderers/overview.lua
ui/journal/renderers/settings.lua
ui/journal/keybinds.lua
ui/journal/horizontal_list.lua
ui/journal/settings_templates.lua
ui/journal/controllers/stats_list.lua
ui/journal/controllers/instance_list.lua
ui/journal/controllers/encounter_list.lua
ui/journal/journal.lua
ui/journal/dialogs.lua
ui/journal/filters.lua
ui/journal/overview_panel.lua
ui/journal/chronicler.lua
ui/journal/subheader.lua
ui/journal/group_table.lua
ui/journal/journal.xml
ui/journal/dialogs.xml

; UI - Onboarding
ui/onboarding/onboarding.lua
ui/onboarding/onboarding.xml

; UI - Character Stats integration
ui/character/character_stats.lua

