{
  "name": "bs-share",
  "private": true,
  "scripts": {
    "gen": "node scripts/gen-icon-overrides.mjs",
    "precheck": "npm run gen",
    "prebuild": "npm run gen",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "node --test tests/*.test.mjs",
    "build": "node build.mjs",
    "predeploy": "npm run check && npm run build",
    "deploy": "wrangler deploy",
    "dev": "npm run check && npm run build && wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.142.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
